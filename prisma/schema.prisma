generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  TODOS @map("todos")
  ENCERRADO @map("encerrado")
  PROXIMO @map("proximo")
}

enum Action {
  CREATE @map("create")
  DELETE @map("delete")
  EDIT @map("edit")
}

model Admin {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))
  email String @unique
  password String

  news News[]
  actionLog ActionLog[]

  @@map("admin")
}

model Team {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))
  name String
  acronym String
  flag String

  groupId Int
  group Group @relation(fields: [groupId], references: [id])

  homeMatches Match[] @relation("HomeMatches")

  awayMathes Match[] @relation("AwayMatches")

  @@map("team")
}

model Group {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))
  name String
  
  teams Team[]
  matches Match[]
  news News[]
}

model Match {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))
  date DateTime
  local String

  homeGoals Int
  awayGoals Int

  status MatchStatus @default(TODOS)

  groupId Int
  group Group @relation(fields: [groupId], references: [id])

  homeTeamId Int
  homeTeam Team @relation("HomeMatches", fields: [homeTeamId], references: [id])

  awayTeamId Int
  awayTeam Team @relation("AwayMatches", fields: [awayTeamId], references: [id])
}

model News {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))

  title String
  summary String
  text String
  image String
  readingTime Int

  authorId Int
  author Admin @relation(fields: [authorId], references: [id])

  groupId Int
  group Group @relation(fields: [groupId], references: [id])

  createdAt DateTime @default(now())
}

model ActionLog {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))

  authorId Int
  author Admin @relation(fields: [authorId], references: [id])

  action Action

  target String
  targetId String
}