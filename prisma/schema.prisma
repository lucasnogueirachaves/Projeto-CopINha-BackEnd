generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  ENCERRADO @map("encerrado")
  PROXIMO @map("proximo")
}

enum Action {
  CREATE @map("create")
  DELETE @map("delete")
  UPDATE @map("update")
}

model Admin {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))
  email String @unique
  password String

  news News[]
  actionLogs ActionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Team {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))
  name String
  acronym String
  flag String

  groupId Int
  group Group @relation(fields: [groupId], references: [id])

  homeMatches Match[] @relation("HomeMatches")

  awayMatches Match[] @relation("AwayMatches")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
} 

model Group {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))
  name String
  
  teams Team[]
  matches Match[]
  news News[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("groups")
}

model Match {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))
  date DateTime
  local String

  homeGoals Int?
  awayGoals Int?

  status MatchStatus @default(PROXIMO)

  groupId Int
  group Group @relation(fields: [groupId], references: [id])

  homeTeamId Int
  homeTeam Team @relation("HomeMatches", fields: [homeTeamId], references: [id])

  awayTeamId Int
  awayTeam Team @relation("AwayMatches", fields: [awayTeamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("match")
}

model News {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))

  title String
  summary String
  text String
  image String
  readingTime Int

  authorId Int
  author Admin @relation(fields: [authorId], references: [id])

  groupId Int?
  group Group? @relation(fields: [groupId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news")
}

model ActionLog {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid(7))

  authorId Int
  author Admin @relation(fields: [authorId], references: [id])

  action Action

  entity String
  entityId String

  createdAt DateTime @default(now())

  @@map("action_log")
}